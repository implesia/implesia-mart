# The canonical production URL of the site (no trailing slash).
# Required for correct absolute URLs in metadata, sitemap.xml, robots.txt,
# JSON-LD structured data and social share images.
NEXT_PUBLIC_SITE_URL=https://mart.implesia.com

# Optional search-engine site verification (the token only, not the whole <meta> tag).
# Google Search Console > Add property > URL prefix > HTML tag: the value of content="...".
# Bing Webmaster Tools > Add site > HTML Meta Tag (msvalidate.01): the value of content="...".
# Leave empty to emit no tag.
# GOOGLE_SITE_VERIFICATION is server-only. On Cloudflare Workers set it as a
# Runtime variable (Workers Builds does not need it at build time). The layout
# reads it per request. NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION is still accepted
# when GOOGLE_SITE_VERIFICATION is empty.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Storefront analytics. Leave empty to keep that tracker off (no script, no events).
# GA4 Admin > Data streams > Web stream > Measurement ID (G-XXXXXXXXXX).
# Meta Events Manager > Data sources > your pixel > Pixel ID (digits).
# Cloudflare Workers: set these as Runtime variables. The server reads them on
# each storefront request (dynamic lookup, so they are not frozen at build) and
# passes them to the browser. A Build variable is not required.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Mart API. No trailing slash.
# Local: http://127.0.0.1:8001
# Production: https://mart-api.implesia.com
NEXT_PUBLIC_MART_API_URL=http://127.0.0.1:8001

# In-app stand-ins (fake quotes, orders, coupons, order alerts, inventory,
# reports) are OFF in every production build. They are allowed only under
# `next dev` or when NEXT_PUBLIC_ENABLE_MOCK=true is set at build time.
# Never set NEXT_PUBLIC_ENABLE_MOCK in wrangler.jsonc or Cloudflare.
# When the API fails, production shows a real, retryable error instead.
NEXT_PUBLIC_ENABLE_MOCK=

# Only while stand-ins are allowed (see above): set to 1 to edit Admin › Site › SEO
# from the in-app stand-in, even when the API is up. While allowed, the stand-in
# is also used when GET /api/v1/admin/site/settings answers 404, 501, or 5xx, or
# when the API cannot be reached. The storefront never reads the stand-in: a
# failed public settings call uses the built-in title and description.
NEXT_PUBLIC_SITE_SETTINGS_MOCK=

# Only while stand-ins are allowed (see above): set to 1 to price checkout
# coupons and fill Admin › Coupons from the in-app mock, even when the API is up.
# While allowed, the mock is also used when the coupon routes answer 404, 501,
# or 5xx, or when the API cannot be reached. A 401 or 422 is shown and is not mocked.
NEXT_PUBLIC_COUPONS_MOCK=

# --- Cloudflare Workers deployment (vinext) ---
# Only needed when deploying with `npm run deploy:vinext`.
# Find your account ID at dash.cloudflare.com (right sidebar of any zone),
# or run `npx wrangler whoami` after `npx wrangler login`.
CLOUDFLARE_ACCOUNT_ID=
# Only needed for CI / non-interactive deploys. Create at
# dash.cloudflare.com/profile/api-tokens using the "Edit Cloudflare Workers" template.
CLOUDFLARE_API_TOKEN=
