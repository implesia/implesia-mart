# The canonical production URL of the site (no trailing slash).
# Required for correct absolute URLs in metadata, sitemap.xml, robots.txt,
# JSON-LD structured data and social share images.
NEXT_PUBLIC_SITE_URL=https://mart.implesia.com

# Optional search-engine site verification (the token only, not the whole <meta> tag).
# Google Search Console > Add property > URL prefix > HTML tag: the value of content="...".
# Bing Webmaster Tools > Add site > HTML Meta Tag (msvalidate.01): the value of content="...".
# Read at build time; leave empty to emit no tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Mart API. No trailing slash.
# Local: http://127.0.0.1:8001
# Production: https://mart-api.implesia.com
NEXT_PUBLIC_MART_API_URL=http://127.0.0.1:8001

# --- Cloudflare Workers deployment (vinext) ---
# Only needed when deploying with `npm run deploy:vinext`.
# Find your account ID at dash.cloudflare.com (right sidebar of any zone),
# or run `npx wrangler whoami` after `npx wrangler login`.
CLOUDFLARE_ACCOUNT_ID=
# Only needed for CI / non-interactive deploys. Create at
# dash.cloudflare.com/profile/api-tokens using the "Edit Cloudflare Workers" template.
CLOUDFLARE_API_TOKEN=
